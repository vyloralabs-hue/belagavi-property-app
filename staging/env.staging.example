# ==============================================================================
# PROPERTYHUB ISOLATED STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place production credentials in this file.
# Copy to .env.staging and fill in isolated staging project values.
# ==============================================================================

ENVIRONMENT=staging
APP_NAME=PropertyHub Staging
BASE_API_URL=https://staging-api.belagaviproperty.com/api/v1

# Supabase Staging Project (Isolated from Production)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_staging_anon_key
SUPABASE_STORAGE_BUCKET=property-media-staging

# Background Queue & Edge Functions
MEDIA_DERIVATIVE_FUNCTION_URL=https://your-staging-project.supabase.co/functions/v1/generate-media-derivatives
ASYNC_WORKER_CONCURRENCY=5

# Synthetic Load Testing Guard (Must be true on staging)
IS_STAGING_ENVIRONMENT=true
ALLOW_SYNTHETIC_DATA_SEEDING=true
STAGING_MAX_TEST_LISTINGS=100000
